# Maintainer: Cloveian <146399971+Cloveian@users.noreply.github.com>
pkgname=emoticond-bin
_pkgname=emoticond
pkgver=1.0.2
pkgrel=1
pkgdesc='A (legitimately) clever kaomoji search engine: CLI, launcher menu and picker daemon (release binary)'
arch=('x86_64' 'aarch64')
url='https://github.com/Cloveian/emoticond'
license=('MIT OR Apache-2.0')
depends=('gcc-libs' 'glibc')
optdepends=('emoticond-data: kaomoji data for every user (or run `emoticond data fetch`)'
            'wl-clipboard: copy picks on Wayland (emoticond menu)'
            'xclip: copy picks on X11 (emoticond menu)'
            'wtype: type picks on Wayland (emoticond menu --action type)'
            'fuzzel: a launcher for emoticond menu (or rofi, wofi, tofi, bemenu, walker, dmenu)')
provides=("$_pkgname=$pkgver")
install=emoticond.install
conflicts=("$_pkgname")
source_x86_64=("$url/releases/download/v$pkgver/$_pkgname-v$pkgver-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/$_pkgname-v$pkgver-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('0c36e08dace5c6201d606cc2cd1b88db10a08c10890c3cb03fff0046c85520ad')
sha256sums_aarch64=('30b8c93fa3f66addc0f60a4b0695d401ed8f6e0878fff6a5bcd20df387611d8d')

package() {
  cd "$_pkgname-v$pkgver-$CARCH-unknown-linux-gnu"
  install -Dm755 emoticond -t "$pkgdir/usr/bin"
  install -Dm644 LICENSE-MIT LICENSE-APACHE -t "$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
}
